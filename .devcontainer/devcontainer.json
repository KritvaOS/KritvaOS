{
    "name": "KritvaOS Development",

    "build": {
        "dockerfile": "Dockerfile",
        "context": "..",
        "args": {
            "USERNAME": "kritva",
            "USER_UID": "1000",
            "USER_GID": "1000"
        }
    },

    "remoteUser": "kritva",

    "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/KritvaOS,type=bind,consistency=cached",

    "workspaceFolder": "/workspaces/KritvaOS",

    "containerEnv": {
        "KRITVA_ROOT": "/workspaces/KritvaOS"
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "llvm-vs-code-extensions.vscode-clangd",
                "ms-vscode.cmake-tools",
                "ms-python.python",
                "ms-python.vscode-pylance",
                "tamasfe.even-better-toml",
                "redhat.vscode-yaml"
            ],

            "settings": {
                "C_Cpp.intelliSenseEngine": "disabled",
                "clangd.arguments": [
                    "--background-index",
                    "--clang-tidy"
                ],

                "cmake.generator": "Ninja",

                "editor.formatOnSave": false,

                "[cpp]": {
                    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
                },

                "[c]": {
                    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
                },

                "[python]": {
                    "editor.defaultFormatter": "ms-python.python"
                }
            }
        }
    },

    "mounts": [
        "source=kritva-build-cache,target=/workspaces/KritvaOS/build,type=volume"
    ],

    "postCreateCommand": "python3 scripts/check_toolchain.py --profile default",

    "postStartCommand": "echo 'Kritva development container ready.'",

    "forwardPorts": [],

    "remoteEnv": {
        "PATH": "${containerEnv:PATH}"
    },

    "features": {},

    "shutdownAction": "stopContainer"
}
