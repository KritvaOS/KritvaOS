root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
indent_size = 2

[*.yml]
indent_size = 2

[*.yaml]
indent_size = 2

[*.json]
indent_size = 2

[*.jsonc]
indent_size = 2

[*.toml]
indent_size = 2

[*.cmake]
indent_size = 2

[CMakeLists.txt]
indent_size = 2

[Makefile]
indent_style = tab

[*.sh]
indent_size = 2

[*.py]
indent_size = 4

[*.cpp]
indent_size = 4

[*.cc]
indent_size = 4

[*.cxx]
indent_size = 4

[*.hpp]
indent_size = 4

[*.hh]
indent_size = 4

[*.h]
indent_size = 4

[*.hxx]
indent_size = 4

[*.sv]
indent_size = 4

[*.svh]
indent_size = 4

[*.v]
indent_size = 4

[*.vh]
indent_size = 4
